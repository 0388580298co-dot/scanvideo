# ScanVideo local configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://scanvideo:scanvideo@postgres:5432/scanvideo
MEDIA_ROOT=/data/media
SECRET_ROOT=/secrets
CELERY_CONCURRENCY=2

# Core pipeline
MIN_VIDEO_DURATION=10
MAX_VIDEO_DURATION=180
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
TRANSLATION_PROVIDER=argos
TTS_PROVIDER=edge
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_VOLUME=0dB
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
BACKGROUND_GAIN_DB=-10
NARRATION_GAIN_DB=3

# Optional public/authorized RSS or Atom feeds for trend discovery.
# JSON list, e.g. ["https://example.com/feed.xml"]
TREND_FEED_URLS=[]

# Optional commercial providers. Leave empty for the $0 local MVP.
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# YouTube official OAuth. Put client_secret.json in SECRET_ROOT.
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CLIENT_SECRETS_FILE=/secrets/client_secret.json
YOUTUBE_TOKEN_FILE=/secrets/youtube_token.json
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/youtube/callback

# TikTok official OAuth / Content Posting API.
TIKTOK_ACCESS_TOKEN=
TIKTOK_TOKEN_FILE=/secrets/oauth/tiktok_token.json
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/oauth/tiktok/callback
