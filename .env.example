# ScanVideo local configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://scanvideo:scanvideo@postgres:5432/scanvideo
MEDIA_ROOT=/data/media

# Core pipeline
MIN_VIDEO_DURATION=10
MAX_VIDEO_DURATION=180
WHISPER_MODEL=small
TRANSLATION_PROVIDER=argos
TTS_PROVIDER=edge
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_VOLUME=0dB
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
BACKGROUND_GAIN_DB=-10
NARRATION_GAIN_DB=3

# Optional commercial providers. Leave empty for the $0 local MVP.
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Official publishing credentials only; never commit real values.
YOUTUBE_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
