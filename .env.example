# ScanVideo
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Infrastructure
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://scanvideo:scanvideo@postgres:5432/scanvideo

# Storage (local for development)
MEDIA_ROOT=/data/media

# AI providers - fill only the providers you actually enable
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
HF_TOKEN=

# Publishing providers are configured per account in the database.
# Never commit real credentials.
